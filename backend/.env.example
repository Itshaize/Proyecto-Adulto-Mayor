# Servidor Express
PORT=3000
HOST=0.0.0.0
# Origen exacto desde el que el navegador abre Angular (sin ruta ni / final).
# Se permiten varios, separados por coma. Ejemplo:
# FRONTEND_URLS=http://192.0.2.20,https://adulto.ejemplo.edu.ec
# Usa * solo temporalmente si aun no conoces la IP/dominio del frontend.
FRONTEND_URLS=http://localhost:4200
# URL publica del backend, sin /api. Swagger la usa para probar peticiones.
PUBLIC_API_URL=http://localhost:3000
# Un dispositivo se muestra desconectado si no reporta durante este tiempo.
DEVICE_OFFLINE_AFTER_MS=120000

# MongoDB Atlas o MongoDB local.
# Déjalo vacío para usar automáticamente los datos de demostración en memoria.
# Ejemplo Atlas: mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/adulto_mayor?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_TEST_URI=

# Usa una cadena larga, aleatoria y privada en producción.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES

# Reservado para la integración Firebase/ESP32.
# Si la clave privada tiene saltos de línea, consérvalos como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=
FIREBASE_LECTURAS_PATH=lecturas
# Alternativa recomendada: GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account.json

# Configuracion publica de la aplicacion web Firebase.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
