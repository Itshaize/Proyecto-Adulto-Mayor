# Servidor Express
PORT=3000
FRONTEND_URL=http://localhost:4200

# MongoDB Atlas o MongoDB local.
# Déjalo vacío para usar automáticamente los datos de demostración en memoria.
# Ejemplo Atlas: mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/adulto_mayor?retryWrites=true&w=majority
MONGODB_URI=

# Usa una cadena larga, aleatoria y privada en producción.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_DE_AL_MENOS_32_CARACTERES

# Reservado para la integración Firebase/ESP32.
# Si la clave privada tiene saltos de línea, consérvalos como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
