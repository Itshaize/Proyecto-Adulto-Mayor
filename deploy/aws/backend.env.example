# API Express: Nginx es el único servicio público.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Reemplazar cuando Hostinger entregue la URL definitiva, sin "/" final.
FRONTEND_URLS=https://TU-SITIO.hostingersite.com
PUBLIC_API_URL=https://TU-DOMINIO-DE-API
DEVICE_OFFLINE_AFTER_MS=120000

# Conservar la cadena real únicamente en /opt/kairos/backend/.env.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/adulto_mayor?retryWrites=true&w=majority
JWT_SECRET=GENERA_UNA_CADENA_ALEATORIA_DE_MAS_DE_32_CARACTERES

# Firebase Admin: el JSON no se guarda en Git.
FIREBASE_DATABASE_URL=https://prueba-bca78-default-rtdb.firebaseio.com
FIREBASE_LECTURAS_PATH=lecturas
FIREBASE_ESTADOS_PATH=estados_dispositivos
FIREBASE_SYNC_INTERVAL_MS=2000
GOOGLE_APPLICATION_CREDENTIALS=/opt/kairos/secrets/firebase-clave.json
