[Unit]
Description=API KAIROS - Adulto Mayor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kairos/backend
EnvironmentFile=/opt/kairos/backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
